# ── Git ───────────────────────────────────────────────────────
.git
.gitignore

# ── Dependencies（各服务自己 npm ci） ─────────────────────────
**/node_modules

# ── 编译产物 ──────────────────────────────────────────────────
**/dist

# ── 前端（后端服务镜像不需要） ─────────────────────────────────
frontend/

# ── 知识库（以 volume 挂载，不打包进镜像） ─────────────────────
knowledge-base/

# ── 基础设施 / 文档 / 脚本（镜像运行时不需要） ─────────────────
infra/
docs/
scripts/

# ── 本地环境文件 ──────────────────────────────────────────────
.env
.env.*
!.env.example

# ── 编辑器 / OS ───────────────────────────────────────────────
.DS_Store
*.log
.vscode/
.idea/
