# ============================================================
# AI 自动化工作流平台 - 环境变量配置
# 使用方法：cp .env.example .env  然后填入真实值
# ⚠️  .env 已在 .gitignore 中，绝对不要提交到代码仓库
# ============================================================

# ── LLM API Keys（至少填一个） ────────────────────────────────
# ANTHROPIC_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── LLM 默认配置 ──────────────────────────────────────────────
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-20250514
# LLM_SPEC_MODEL=claude-sonnet-4-20250514
LLM_PROVIDER=qwen
LLM_MODEL=qwen3.6-plus
LLM_SPEC_MODEL=qwen3.6-plus

# ── 数据库密码（生产环境请替换强密码） ───────────────────────
POSTGRES_PASSWORD=awp_secret_2024
NEO4J_PASSWORD=awp_neo4j_2024
CHROMA_TOKEN=awp_chroma_token_2024

# ── 管理后台 ──────────────────────────────────────────────────
ADMIN_API_KEY=awp_admin_2024
GRAFANA_PASSWORD=awp_grafana_2024

# ── 功能开关 ──────────────────────────────────────────────────
ENABLE_SONARQUBE=false
SONARQUBE_TOKEN=
ENABLE_MEMORY_SYSTEM=true
SANDBOX_TIMEOUT_SECONDS=60
ENABLE_VECTOR_SEARCH=true

# ── Neo4j 图谱 ────────────────────────────────────────────────
NEO4J_HOST=localhost
NEO4J_HTTP_PORT=7474

# ── Kong API 网关 ─────────────────────────────────────────────
# Kong 使用声明式配置（DB-less），配置文件：infra/kong/kong.yml
# 统一入口: http://localhost:8000
# Admin API: http://localhost:8002 (仅开发环境)
ENABLE_KONG=true

# ── 多租户 ────────────────────────────────────────────────────
DEFAULT_PROJECT_ID=default
