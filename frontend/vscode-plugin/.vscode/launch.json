{
  "version": "0.2.0",
  "configurations": [
    {
      // ── 主调试入口：启动 Extension Development Host ────────
      "name": "运行插件 (F5)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "preLaunchTask": "npm: compile",
      "sourceMaps": true,
      "smartStep": true,
      "internalConsoleOptions": "openOnSessionStart"
    },
    {
      // ── 监听模式：tsc -watch + 附加调试器 ─────────────────
      // 先在终端运行 npm run watch，再用这个配置附加
      "name": "附加到已运行的插件 (watch 模式)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "sourceMaps": true,
      "smartStep": true
    }
  ]
}
